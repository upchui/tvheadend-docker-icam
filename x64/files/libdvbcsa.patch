+    WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+    General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with libdvbcsa; if not, write to the Free Software Foundation,
+    Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA
+
+    ICAM (CSA-ALT) key setup test: mode 4 uses the bit permuted CW
+    bytes 0 and 4 for the block cipher and the original CW for the
+    stream cipher, all other modes are standard CSA.
+
+*/
+
+#include <stdio.h>
+#include <string.h>
+
+#include <dvbcsa/dvbcsa.h>
+#include "dvbcsa_bs.h"
+
+/* destination bit of each CW bit, independent from the lookup table */
+static const int perm_bit[8] = { 1, 7, 5, 2, 6, 0, 3, 4 };
+
+static unsigned char
+perm_ecm(unsigned char v)
+{
+  unsigned char r = 0;
+  int i;
+
+  for (i = 0; i < 8; i++)
+    if (v & (1 << i))
+      r |= 1 << perm_bit[i];
+
+  return r;
+}
+
+int
+main(void)
+{
+  struct dvbcsa_bs_key_s *key = dvbcsa_bs_key_alloc();
+  struct dvbcsa_bs_key_s *ref = dvbcsa_bs_key_alloc();
+  struct dvbcsa_bs_key_s *alt = dvbcsa_bs_key_alloc();
+  dvbcsa_cw_t cw, cw_alt;
+  unsigned int seed = 1;
+  int n, i, ecm, fail = 0;
+
+  for (n = 0; n < 256; n++)
+    {
+      for (i = 0; i < 8; i++)
+        {
+          seed = seed * 1103515245 + 12345;
+          cw[i] = seed >> 16;
+        }
+      /* cover all values of the permuted bytes */
+      cw[0] = n;
+      cw[4] = 255 - n;
+
+      dvbcsa_bs_key_set(cw, ref);
+
+      for (ecm = 0; ecm < 256; ecm++)
+        {
+          if (ecm == 4)
+            continue;
+          dvbcsa_bs_key_set_ecm(ecm, cw, key);
+          if (memcmp(key, ref, sizeof(*key)))
+            {
+              printf("ecm %d: key differs from dvbcsa_bs_key_set(), n=%d\n", ecm, n);
+              fail++;
+            }
+        }
+
+      memcpy(cw_alt, cw, sizeof(cw_alt));
+      cw_alt[0] = perm_ecm(cw[0]);
+      cw_alt[4] = perm_ecm(cw[4]);
+      dvbcsa_bs_key_set(cw_alt, alt);
+      dvbcsa_bs_key_set_ecm(4, cw, key);
+
+      if (memcmp(key->block, alt->block, sizeof(key->block)))
+        {
+          printf("ecm 4: wrong block key, n=%d\n", n);
+          fail++;
+        }
+      if (memcmp(key->stream, ref->stream, sizeof(key->stream)))
+        {
+          printf("ecm 4: wrong stream key, n=%d\n", n);
+          fail++;
+        }
+    }
+
+  dvbcsa_bs_key_free(alt);
+  dvbcsa_bs_key_free(ref);
+  dvbcsa_bs_key_free(key);
+
+  puts(fail ? "FAILED" : "OK");
+
+  return fail ? 1 : 0;
+}

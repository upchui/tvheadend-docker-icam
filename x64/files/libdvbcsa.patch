index f480e678871b6de1daab00b2a8cac687a7eeb4f2..c71bb5f4682d8a34511dc6dcdab9aacccae4e667 100644
--- a/README
+++ b/README
@@ -135,6 +135,19 @@ Example:
     dvbcsa_bs_encrypt(key, b, 184);
 
 
+ICAM (CSA-ALT)
+==============
+
+dvbcsa_bs_key_set_ecm() takes an additional ECM mode, 4 selects the
+ICAM (VideoGuard CSA-ALT) block cipher key, any other value is standard
+CSA and equal to dvbcsa_bs_key_set(). DVBCSA_KEY_ECM is defined by
+dvbcsa/dvbcsa.h when the function is available.
+
+    unsigned char ecm = (caid >> 8 == 0x09 && ecm_data[4] != 0 &&
+                         (ecm_data[2] - ecm_data[4]) == 4) ? 4 : 0;
+    dvbcsa_bs_key_set_ecm(ecm, cw, key);
+
+
 Portability
 ===========
 

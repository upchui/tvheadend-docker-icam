+/*
+ * Track the ICAM (CSA-ALT) mode of the VideoGuard ECMs, the keys
+ * received afterwards are bound to this mode in descrambler_keys()
+ */
+static void
+descrambler_ecm_mode_update ( mpegts_service_t *t, int pid, const uint8_t *ptr )
+{
+  th_descrambler_runtime_t *dr;
+  elementary_stream_t *st;
+  caid_t *ca;
+  int mode = -1;
+
+  tvh_mutex_lock(&t->s_stream_mutex);
+  if ((dr = t->s_descramble) != NULL) {
+    TAILQ_FOREACH(st, &t->s_components.set_filter, es_filter_link) {
+      if (st->es_pid != pid) continue;
+      LIST_FOREACH(ca, &st->es_caids, link) {
+        if (ca->use == 0 || !caid_is_videoguard(ca->caid)) continue;
+        mode = (ptr[4] != 0 && (ptr[2] - ptr[4]) == 4) ? 4 : 0;
+        break;
+      }
+      if (mode >= 0) break;
+    }
+    if (mode >= 0 && mode != dr->dr_ecm_mode) {
+      tvhinfo(LS_DESCRAMBLER, "ICAM (patched by thealhu's flavor of TVHeadend) %s for service \"%s\" (ECM pid %d)",
+              mode ? "enabled" : "disabled", t->s_dvb_svcname, pid);
+      dr->dr_ecm_mode = mode;
+    }
+  }
+  tvh_mutex_unlock(&t->s_stream_mutex);
+}
+
